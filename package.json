{
  "name": "ddga",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:verify-schema": "bash scripts/verify-schema.sh",
    "db:verify-migration": "bash scripts/verify-migration.sh",
    "db:migrate": "node --experimental-strip-types packages/db/scripts/migrate.ts",
    "db:verify-schema-types": "vitest run packages/db",
    "dev:api": "node --experimental-strip-types --env-file=.env apps/api/src/server.ts",
    "dev:web": "pnpm --filter @ddga/web dev",
    "db:setup-dev": "bash scripts/setup-dev-db.sh",
    "auth:link": "node --experimental-strip-types --env-file=.env apps/api/scripts/dev-auth-link.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
