# Copy to .env and fill in. Never commit .env.
#
# Local development database (Postgres 16 in Docker):
#   docker run -d --name ddga-postgres --restart unless-stopped \
#     -e POSTGRES_PASSWORD=<your-password> -e POSTGRES_DB=golf \
#     -v ddga_pgdata:/var/lib/postgresql/data \
#     -p 127.0.0.1:5433:5432 postgres:16
DATABASE_URL=postgresql://postgres:<password>@127.0.0.1:5433/golf
