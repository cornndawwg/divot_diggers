# Copy to .env and fill in. Never commit .env.
#
# Local development database (Postgres 16 in Docker):
#   docker run -d --name ddga-postgres --restart unless-stopped \
#     -e POSTGRES_PASSWORD=<your-password> -e POSTGRES_DB=golf \
#     -v ddga_pgdata:/var/lib/postgresql/data \
#     -p 127.0.0.1:5433:5432 postgres:16
DATABASE_URL=postgresql://postgres:<password>@127.0.0.1:5433/golf

# Signs session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET=<64 hex characters>

# Where each app runs locally.
API_URL=http://localhost:8787
WEB_URL=http://localhost:3000

# Mailgun, for verification and password-reset email.
MAILGUN_API=<mailgun private api key>
MAILGUN_DOMAIN=<sending domain, e.g. example.com>
# Optional; defaults to "Divot Diggers <noreply@$MAILGUN_DOMAIN>"
MAIL_FROM=

# Optional but important in production: a NON-OWNING Postgres role for domain
# queries. A table owner bypasses its own RLS policies. Without this, the API
# falls back to DATABASE_URL and warns on startup.
APP_DATABASE_URL=

# The origin browsers use. Emailed links are built on this, so it must be reachable from
# wherever mail is read. Defaults to WEB_URL.
PUBLIC_URL=http://localhost:3000
WEB_URL=http://localhost:3000

# Where the console's /api/* proxy forwards to. The API's own port, not public.
API_INTERNAL_URL=http://localhost:8787
